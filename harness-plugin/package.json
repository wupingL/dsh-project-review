{
  "name": "@local/recsdk-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RecSDK 代码检视：GitCode PR 列表 + AI 审查结果整页视图（DeepSeek Harness 插件）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
